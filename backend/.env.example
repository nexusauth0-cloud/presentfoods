# Server
PORT=5000

# Auth — required in production. Without it, tokens are signed with a
# hardcoded development fallback ("fallback-secret"), which is NOT safe.
JWT_SECRET=change-me-to-a-long-random-string

# Code users must enter at signup to register as an admin.
# Leave unset to disable admin signups entirely.
ADMIN_CODE=change-me-admin-code

# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:5173

# Legacy: only used by the unused /api/wallet/initialize Paystack route.
# PAYSTACK_SECRET_KEY=
